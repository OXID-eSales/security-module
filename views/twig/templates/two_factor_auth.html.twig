{% capture append = "oxidBlock_content" %}
    <h1 class="page-header">{{ translate({ ident: "TWO_FACTOR_AUTHENTICATION_TITLE" }) }}</h1>
    <p >{{ translate({ ident: "TWO_FACTOR_AUTHENTICATION_DESCRIPTION" }) }}</p>
    <br>
    <form action="{{ oViewConf.getSelfLink()|raw }}" name="two_factor_auth" method="post" role="form">
        <div class="hidden">
            {{ oViewConf.getHiddenSid()|raw }}
            <input type="hidden" name="cl" value="twofactorauth">
            <input type="hidden" name="fnc" value="handleOTP">
        </div>
        <div>
            <input type="text" class="editinput" maxlength="254" id="auth_code" name="auth_code" value="">
            <button
                class="btn btn-primary submitButton largeButton"
                type="submit"
                id="auth_submit"
                class="submitButton"
            >{{ translate({ ident: "SUBMIT" }) }}</button>
        </div>
        <div>
            <button
                id="resend-btn"
                class="btn btn-secondary submitButton largeButton"
                type="button"
                data-cooldown="60"
                data-url="{{ seo_url({ ident: oViewConf.getSelfLink()|cat("cl=twofactorauth&fnc=resendCode") }) }}"
            >{{ translate({ ident: "RESEND_CODE" }) }}</button>
            <p id="resend-hint" aria-live="polite"></p>
        </div>
    </form>
    <br>
{% endcapture %}

{% include "layout/page.html.twig" %}
<script type="module" src="{{ oViewConf.getModuleUrl('oe_security_module', 'out/src/js/index.js') }}"></script>
