{% extends 'form/user_password.html.twig' %}

{% set passwordSettings = oViewConf.getSecurityModulePasswordSettings() %}

{% block user_change_password %}
    {% if oViewConf.isExternalAuthUser() %}
        <p class="alert alert-info">
            {{ translate({ ident: "OE_SECURITY_EXTERNAL_AUTH_PASSWORD_INFO" }) }}
        </p>
        <a href="{{ seo_url({ ident: oViewConf.getSelfLink() ~ "cl=forgotpwd" }) }}" class="btn btn-link px-0">
            {{ translate({ ident: "OE_SECURITY_RESET_PASSWORD" }) }}
        </a>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block user_change_password_button %}
    {% if not oViewConf.isExternalAuthUser() %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block user_change_password_old %}
    {{ parent() }}

    {% if passwordSettings.isPasswordPolicyEnabled() %}
        {% include '@oe_security_module/form/password_toggle.html.twig' with { target: 'passwordOld' } %}
    {% endif %}
{% endblock %}

{% block user_change_password_new %}
    {{ parent() }}
    {% if passwordSettings.isPasswordPolicyEnabled() %}
        {% include '@oe_security_module/form/password.html.twig' with {
            target: 'passwordNew',
            confirmation: 'passwordNewConfirm',
        } %}
    {% endif %}
{% endblock %}

{% block user_change_password_confirm %}
    {{ parent() }}

    {% if passwordSettings.isPasswordPolicyEnabled() %}
        {% include '@oe_security_module/form/password_toggle.html.twig' with { target: 'passwordNewConfirm' } %}
    {% endif %}
{% endblock %}

